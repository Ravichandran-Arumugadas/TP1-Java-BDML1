package gestionMagasin;

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        Magasin magasin = new Magasin();

        Produit produit1 = new Produit(1, "Ordinateur", 800, 5);
        Produit produit2 = new Produit(2, "Telephone", 500, 10);
        Produit produit3 = new Produit(3, "Casque", 100, 15);

        magasin.ajouterProduit(produit1);
        magasin.ajouterProduit(produit2);
        magasin.ajouterProduit(produit3);

        Client client = new Client(
                1,
                "dupont@gmail.com",
                "Dupont"
        );

        Panier panier = new Panier();

        int choix = 0;

        while (choix != 5) {

            System.out.println("\n--- Menu Magasin ---");
            System.out.println("1. Afficher les produits disponibles");
            System.out.println("2. Ajouter un produit au panier");
            System.out.println("3. Afficher le panier");
            System.out.println("4. Passer la commande");
            System.out.println("5. Quitter");

            System.out.print("Votre choix : ");
            choix = scanner.nextInt();
            scanner.nextLine();

            switch (choix) {

                case 1:
                    magasin.afficherProduitsDisponibles();
                    break;

                case 2:
                    System.out.print("Entrez le nom du produit : ");
                    String nomProduit = scanner.nextLine();
                    Produit produitTrouve =
                            magasin.trouverProduitParNom(nomProduit);
                    if (produitTrouve != null) {
                        System.out.println(
                                "Quantité disponible : "
                                        + produitTrouve.getQuantité()
                        );
                        System.out.print("Quantité souhaitée : ");
                        int quantiteSouhaitee = scanner.nextInt();
                        scanner.nextLine();
                        if (quantiteSouhaitee > 0) {
                            if (quantiteSouhaitee <= produitTrouve.getQuantité()) {
                                Produit produitPanier = new Produit(
                                        produitTrouve.getId(),
                                        produitTrouve.getNom(),
                                        produitTrouve.getPrix(),
                                        quantiteSouhaitee
                                );
                                panier.ajouterProduit(produitPanier);
                                int nouveauStock =
                                        produitTrouve.getQuantité()
                                                - quantiteSouhaitee;
                                produitTrouve.setQuantité(nouveauStock);
                                System.out.println(
                                        "Produit ajouté au panier"
                                );

                                System.out.println(
                                        "Stock restant : "
                                                + produitTrouve.getQuantité()
                                );

                            } else {
                                System.out.println(
                                        "Quantité insuffisante en stock"
                                );
                                System.out.println(
                                        "Quantité disponible : "
                                                + produitTrouve.getQuantité()
                                );
                            }
                        } else {
                            System.out.println(
                                    "La quantité doit être supérieure à 0"
                            );
                        }
                    } else {
                        System.out.println(
                                "Produit introuvable"
                        );
                    }
                    break;

                case 3:
                    System.out.println("\n--- Votre panier ---");
                    panier.afficherPanier();
                    System.out.println(
                            "Total : "
                                    + panier.calculerTotal()
                                    + " €"
                    );
                    break;
                case 4:
                    if (panier.getProduits().size() > 0) {
                        Commande commande = new Commande(
                                1,
                                client,
                                panier,
                                panier.calculerTotal()
                        );
                        System.out.println(
                                "\n--- Commande ---"
                        );
                        commande.afficherDetailsCommande();
                    } else {
                        System.out.println(
                                "Votre panier est vide"
                        );
                    }
                    break;

                case 5:
                    System.out.println("Au revoir");
                    break;
                default:
                    System.out.println(
                            "Choix incorrect"
                    );
            }
        }
        scanner.close();
    }
}
